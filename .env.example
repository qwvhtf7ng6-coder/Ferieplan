# Neon pooled connection (use this for runtime queries — supports many concurrent connections)
# Get from Neon Console → Connection Details → "Pooled connection"
DATABASE_URL="postgresql://USER:PASS@ep-xxxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Neon direct connection (used by Prisma migrations, requires direct PostgreSQL connection)
# Get from Neon Console → Connection Details → "Direct connection"  
DIRECT_URL="postgresql://USER:PASS@ep-xxxxx.region.aws.neon.tech/dbname?sslmode=require"

NEXTAUTH_SECRET="change-me-to-a-random-string-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Kræves af Vercel Cron-jobbet (/api/cron/reminders).
# Sæt til en tilfældig streng (fx: openssl rand -hex 32).
# Vercel Cron sender automatisk headeren "Authorization: Bearer <CRON_SECRET>".
# Endpointet returnerer 401 hvis variablen ikke er sat eller ikke matcher.
CRON_SECRET="skift-mig-til-en-tilfaeldig-streng"
