DATABASE_URL="postgresql://postgres:password@localhost:5432/ferieplan"
NEXTAUTH_SECRET="change-me-to-a-random-string-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Kræves af Vercel Cron-jobbet (/api/cron/reminders).
# Sæt til en tilfældig streng (fx: openssl rand -hex 32).
# Vercel Cron sender automatisk headeren "Authorization: Bearer <CRON_SECRET>".
# Endpointet returnerer 401 hvis variablen ikke er sat eller ikke matcher.
CRON_SECRET="skift-mig-til-en-tilfaeldig-streng"
