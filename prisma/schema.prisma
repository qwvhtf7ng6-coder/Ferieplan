generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  EMPLOYEE
  MANAGER
  ADMIN
  SUPER_ADMIN
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum EntryType {
  FULL_DAY
  HALF_DAY_AM
  HALF_DAY_PM
}

enum AbsenceType {
  VACATION
  VACATION_FREE
  MATERNITY
  CHILD_SICK_DAY
  SICK
}

enum VisibilitySetting {
  ALL_EMPLOYEES
  MANAGEMENT_ONLY
}

enum NotificationType {
  REQUEST_APPROVED
  REQUEST_REJECTED
  REQUEST_CANCELLED
  REQUEST_EDITED
  NEW_REQUEST_SUBMITTED
  PENDING_REMINDER
}

// ---------------------------------------------------------------------------
// Organization (tenant)
// ---------------------------------------------------------------------------

model Organization {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  status    OrgStatus @default(ACTIVE)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users            User[]
  departments      Department[]
  requests         VacationRequest[]
  holidays         Holiday[]
  settings         AppSettings?
  auditLogs        AuditLog[]
  notifications    Notification[]
  shiftTemplates   ShiftTemplate[]
  shiftPatterns    ShiftPattern[]
  shiftAssignments ShiftAssignment[]
  vacationBalances VacationBalance[]

  @@index([status])
}

// ---------------------------------------------------------------------------
// Department
// ---------------------------------------------------------------------------

model Department {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  maxConcurrent  Int          @default(2)
  shiftsEnabled  Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  users          User[]
  requests       VacationRequest[]
  shiftTemplates ShiftTemplate[]

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------

model User {
  id             String        @id @default(cuid())
  // null only for SUPER_ADMIN
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String
  password       String
  role           Role          @default(EMPLOYEE)
  departmentId   String?
  department     Department?   @relation(fields: [departmentId], references: [id])
  loginAttempts  Int           @default(0)
  lockedUntil    DateTime?
  canManageShifts Boolean      @default(false)
  permissions    Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  requests         VacationRequest[]
  auditLogs        AuditLog[]
  accounts         Account[]
  sessions         Session[]
  notifications    Notification[]
  shiftAssignments ShiftAssignment[]
  shiftPatterns    ShiftPattern[]
  vacationBalances VacationBalance[]

  // Same email allowed across orgs; SUPER_ADMIN has null orgId so unique on email alone for them
  @@unique([email, organizationId])
  @@index([organizationId])
  @@index([organizationId, role])
}

// ---------------------------------------------------------------------------
// NextAuth models (not org-scoped — they reference User by id)
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// VacationRequest
// ---------------------------------------------------------------------------

model VacationRequest {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String
  departmentId    String
  status          RequestStatus @default(PENDING)
  note            String?
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department             @relation(fields: [departmentId], references: [id])
  entries    VacationRequestEntry[]
  auditLogs  AuditLog[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([departmentId, status])
  @@index([status, createdAt])
}

model VacationRequestEntry {
  id          String      @id @default(cuid())
  requestId   String
  date        DateTime
  type        EntryType   @default(FULL_DAY)
  absenceType AbsenceType @default(VACATION)
  days        Float       @default(1)
  request     VacationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Holiday (per org — each org manages their own)
// ---------------------------------------------------------------------------

model Holiday {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  date           DateTime
  isNational     Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@index([organizationId, date])
}

// ---------------------------------------------------------------------------
// AppSettings (one row per org)
// ---------------------------------------------------------------------------

model AppSettings {
  id                     String            @id @default(cuid())
  organizationId         String            @unique
  organization           Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  calendarVisibility     VisibilitySetting @default(ALL_EMPLOYEES)
  reminderThresholdDays  Int               @default(3)
  vacationBalanceEnabled Boolean           @default(false)
  updatedAt              DateTime          @updatedAt
}

// ---------------------------------------------------------------------------
// AuditLog
// ---------------------------------------------------------------------------

model AuditLog {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  requestId      String?
  action         String
  details        String?
  createdAt      DateTime         @default(now())

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  request VacationRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([requestId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Notification
// ---------------------------------------------------------------------------

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  type           NotificationType
  title          String
  message        String
  link           String?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, readAt])
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// ShiftTemplate
// ---------------------------------------------------------------------------

model ShiftTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String
  name           String
  startTime      String
  endTime        String
  color          String       @default("#3b82f6")
  dayTimeRules   String?
  createdAt      DateTime     @default(now())

  department  Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  assignments ShiftAssignment[]
  patterns    ShiftPattern[]

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// ShiftPattern
// ---------------------------------------------------------------------------

model ShiftPattern {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  departmentId   String
  templateId     String
  userId         String
  startDate      DateTime
  endDate        DateTime
  recurrenceType String       @default("weekly")
  intervalWeeks  Int          @default(1)
  weekdayRules   String
  note           String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  template ShiftTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
  @@index([userId, startDate])
  @@index([departmentId])
}

// ---------------------------------------------------------------------------
// VacationBalance
// ---------------------------------------------------------------------------

model VacationBalance {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  year           Int
  totalDays      Float        @default(25)
  carryOverDays  Float        @default(0)
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
  @@index([organizationId, userId])
  @@index([userId])
  @@index([year])
}

// ---------------------------------------------------------------------------
// ShiftAssignment
// ---------------------------------------------------------------------------

model ShiftAssignment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  templateId     String
  date           DateTime
  note           String?
  createdAt      DateTime     @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  template ShiftTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([userId, date, templateId])
  @@index([organizationId, date])
  @@index([date])
  @@index([userId, date])
}
