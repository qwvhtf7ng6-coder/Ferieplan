generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  MANAGER
  ADMIN
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum EntryType {
  FULL_DAY
  HALF_DAY_AM
  HALF_DAY_PM
}

enum AbsenceType {
  VACATION
  VACATION_FREE
  MATERNITY
  CHILD_SICK_DAY
  SICK
}

enum VisibilitySetting {
  ALL_EMPLOYEES
  MANAGEMENT_ONLY
}

enum NotificationType {
  REQUEST_APPROVED
  REQUEST_REJECTED
  REQUEST_CANCELLED
  REQUEST_EDITED
  NEW_REQUEST_SUBMITTED
  PENDING_REMINDER
}

model Department {
  id              String            @id @default(cuid())
  name            String
  maxConcurrent   Int               @default(2)
  shiftsEnabled   Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  users           User[]
  requests        VacationRequest[]
  shiftTemplates  ShiftTemplate[]
}

model User {
  id             String            @id @default(cuid())
  name           String
  email          String            @unique
  password       String
  role           Role              @default(EMPLOYEE)
  departmentId   String?
  department     Department?       @relation(fields: [departmentId], references: [id])
  loginAttempts  Int               @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  requests       VacationRequest[]
  auditLogs      AuditLog[]
  accounts       Account[]
  sessions       Session[]
  notifications  Notification[]
  shiftAssignments ShiftAssignment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model VacationRequest {
  id             String                @id @default(cuid())
  userId         String
  departmentId   String
  status         RequestStatus         @default(PENDING)
  note           String?
  rejectionReason String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  user           User                  @relation(fields: [userId], references: [id])
  department     Department            @relation(fields: [departmentId], references: [id])
  entries        VacationRequestEntry[]
  auditLogs      AuditLog[]
}

model VacationRequestEntry {
  id           String      @id @default(cuid())
  requestId    String
  date         DateTime
  type         EntryType   @default(FULL_DAY)
  absenceType  AbsenceType @default(VACATION)
  days         Float       @default(1)
  request      VacationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model Holiday {
  id          String   @id @default(cuid())
  name        String
  date        DateTime
  isNational  Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model AppSettings {
  id                   String            @id @default(cuid())
  calendarVisibility   VisibilitySetting @default(ALL_EMPLOYEES)
  reminderThresholdDays Int              @default(3)
  updatedAt            DateTime          @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  requestId String?
  action    String
  details   String?
  createdAt DateTime @default(now())
  user      User            @relation(fields: [userId], references: [id])
  request   VacationRequest? @relation(fields: [requestId], references: [id])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model ShiftTemplate {
  id           String   @id @default(cuid())
  departmentId String
  name         String
  startTime    String   // "08:00"
  endTime      String   // "16:00"
  color        String   @default("#3b82f6")
  createdAt    DateTime @default(now())
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  assignments  ShiftAssignment[]
}

model ShiftAssignment {
  id           String        @id @default(cuid())
  userId       String
  templateId   String
  date         DateTime
  note         String?
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  template     ShiftTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([userId, date, templateId])
  @@index([date])
  @@index([userId, date])
}
